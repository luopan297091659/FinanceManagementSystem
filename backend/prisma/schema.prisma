generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum RoomStatus {
  VACANT
  OCCUPIED
  OVERDUE
  INACTIVE
}

enum LinkStatus {
  ACTIVE
  ENDED
  PENDING
}

enum OwnerType {
  PERSON
  COMPANY
}

enum FeeCategory {
  INCOME
  EXPENSE
  BOTH
}

enum FeeValueType {
  MONEY
  NUMBER
  TEXT
  DATE
}

enum ContractStatus {
  DRAFT
  ACTIVE
  CANCELLATION_SETTLEMENT
  EXPIRED
  TERMINATED
  FUTURE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum BankTransactionDirection {
  CREDIT
  DEBIT
}

enum ReconciliationStatus {
  UNMATCHED
  MATCHED
  MANUAL_REVIEW
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FundProcessingStatus {
  INCLUDED
  DETAIL_ONLY
  DUPLICATE_EXCLUDED
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum AlertStatus {
  OPEN
  SELECTED_FOR_FIX
  FIXING
  RESOLVED
  IGNORED
}

enum FeeBearer {
  OWNER
  COMPANY
  NEGOTIATED
}

enum SettlementStatus {
  DRAFT
  CONFIRMED
  REMITTED
}

enum ThresholdScope {
  GLOBAL
  PROPERTY
  CONTRACT
}

enum PageReadStatus {
  READ
  UNREAD
  FAILED
}

enum DataScopeType {
  ALL
  PROJECT
  PROPERTY
  SELF
  READ_ONLY
}

enum ReconciliationBatchStatus {
  PENDING
  UPLOADED
  PARSING
  PARSED
  MATCHING
  MANUAL_REVIEW
  PARTIAL_COMPLETED
  COMPLETED
  FAILED
}

enum ReconciliationRecordMatchMode {
  AUTO
  MANUAL
  UNMATCHED
}

enum ReconciliationRecordMatchStatus {
  AUTO_MATCHED
  MANUAL_MATCHED
  MANUAL_REVIEW
  UNMATCHED
  SUBMITTED
  FAILED
}

enum ContractPartyType {
  CONTRACTOR
  PAYER
  TENANT
  GUARANTOR
}

enum TranslationStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

model ManagementCompany {
  id         String     @id @default(uuid())
  name       String
  phone      String?
  email      String?
  address    String?
  properties Property[]
  rooms      Room[]
  users      User[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model User {
  id                    String               @id @default(uuid())
  companyId             String?
  company               ManagementCompany?   @relation(fields: [companyId], references: [id])
  username              String               @unique
  email                 String?              @unique
  name                  String
  phone                 String?
  passwordHash          String
  role                  String               @default("operator")
  isActive              Boolean              @default(true)
  defaultDataScope      DataScopeType?       @default(SELF)
  defaultDataScopeValue String?
  userRoles             UserRole[]
  passwordResetTokens   PasswordResetToken[]
  rbacAuditLogs         RbacAuditLog[]
  reconciliationTemplates ReconciliationTemplate[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  code            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  isActive        Boolean          @default(true)
  dataScope       DataScopeType    @default(SELF)
  dataScopeValue  String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  module          String
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

model UserDataScope {
  id         String        @id @default(uuid())
  userId     String?
  roleId     String?
  scopeType  DataScopeType @default(SELF)
  scopeValue String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  purpose   String    @default("PASSWORD_RESET")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model RbacAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  targetId  String?
  ip        String?
  details   String?
  createdAt DateTime @default(now())
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TranslationEntry {
  id          String            @id @default(cuid())
  key         String
  module      String
  locale      String
  value       String
  description String?
  version     String
  status      TranslationStatus @default(DRAFT)
  enabled     Boolean           @default(true)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([key, locale, version])
  @@index([module])
  @@index([locale])
  @@index([status])
}

model Project {
  id         String     @id @default(uuid())
  name       String     @unique
  address    String?
  note       String?
  properties Property[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Property {
  id                    String                                 @id @default(uuid())
  propertyCode          String?                                @unique
  projectId             String?
  project               Project?                               @relation(fields: [projectId], references: [id])
  companyId             String?
  company               ManagementCompany?                     @relation(fields: [companyId], references: [id])
  name                  String
  normalizedName        String?
  nameKana              String?
  postalCode            String?
  address               String?
  normalizedAddress     String?
  addressLine1          String?
  addressLine2          String?
  ward                  String?
  city                  String?                                @default("Osaka")
  prefecture            String?                                @default("Osaka")
  latitude              Decimal?                               @db.Decimal(10, 7)
  longitude             Decimal?                               @db.Decimal(10, 7)
  location              Unsupported("geography(Point, 4326)")?
  buildingType          String?
  usageType             String?
  managementStatus      String                                 @default("ACTIVE")
  currentOwnerSummary   String?
  remark                String?                                @db.Text
  sourceDataJson        Json?
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?
  note                  String?
  rooms                 Room[]
  contracts             Contract[]
  ownerships            PropertyOwnership[]
  importRows            PropertyImportRow[]
  documents             Document[]
  anomalyAlerts         AnomalyAlert[]
  reconciliationRecords ReconciliationRecord[]
  createdAt             DateTime                               @default(now())
  updatedAt             DateTime                               @updatedAt

  @@unique([projectId, name])
  @@index([city, ward])
  @@index([normalizedName, normalizedAddress])
  @@index([postalCode])
  @@index([managementStatus])
  @@index([deletedAt])
  @@index([deletedAt, name])
}

model Room {
  id                      String                                 @id @default(uuid())
  roomCode                String?                                @unique
  propertyId              String
  property                Property                               @relation(fields: [propertyId], references: [id])
  companyId               String?
  company                 ManagementCompany?                     @relation(fields: [companyId], references: [id])
  houseNumber             String?                                @unique
  roomNumber              String?
  normalizedRoomNumber    String?
  displayName             String?
  unitType                String                                 @default("ROOM")
  area                    Decimal?                               @db.Decimal(10, 2)
  floor                   Int?
  floorLabel              String?
  usageType               String?
  latitude                Decimal?                               @db.Decimal(10, 7)
  longitude               Decimal?                               @db.Decimal(10, 7)
  location                Unsupported("geography(Point, 4326)")?
  status                  RoomStatus                             @default(VACANT)
  note                    String?
  legacyTenantId          String?
  legacyMonthlyRent       Decimal?                               @db.Decimal(18, 2)
  legacyContractStartDate DateTime?
  legacyContractEndDate   DateTime?
  currentContractId       String?
  currentOwnerSummary     String?
  remark                  String?                                @db.Text
  sourceDataJson          Json?
  createdBy               String?
  updatedBy               String?
  deletedAt               DateTime?
  tenantLinks             RoomTenant[]
  ownerLinks              RoomOwner[]
  contracts               Contract[]
  transactions            Transaction[]
  documents               Document[]
  anomalyAlerts           AnomalyAlert[]
  reconciliationRecords   ReconciliationRecord[]
  importRows              PropertyImportRow[]
  createdAt               DateTime                               @default(now())
  updatedAt               DateTime                               @updatedAt

  @@unique([propertyId, roomNumber])
  @@unique([propertyId, normalizedRoomNumber])
  @@index([propertyId])
  @@index([roomNumber])
  @@index([unitType])
  @@index([status])
  @@index([deletedAt])
  @@index([deletedAt, propertyId, roomNumber])
}

model Tenant {
  id           String          @id @default(uuid())
  customerCode String?         @unique
  name         String
  nameKana     String?
  nationality  String?
  phone        String?         @unique
  email        String?         @unique
  birthDate    DateTime?
  occupation   String?
  annualIncome Decimal?        @db.Decimal(18, 2)
  address1     String?
  address2     String?
  address3     String?
  note         String?
  rooms        RoomTenant[]
  contracts    Contract[]
  documents    Document[]
  bankAliases  BankNameAlias[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Owner {
  id                 String              @id @default(uuid())
  ownerCode          String?             @unique
  customerCode       String?             @unique
  ownerType          OwnerType           @default(PERSON)
  name               String
  nameKana           String?
  representativeName String?
  companyName        String?
  postalCode         String?
  address            String?
  companyPhone       String?
  phone              String?             @unique
  email              String?             @unique
  address1           String?
  address2           String?
  address3           String?
  bankAccountInfo    Json?
  taxInfo            Json?
  ownerStatus        String              @default("ACTIVE")
  remark             String?             @db.Text
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?
  note               String?
  rooms              RoomOwner[]
  propertyOwnerships PropertyOwnership[]
  documents          Document[]
  bankAliases        BankNameAlias[]
  settlements        OwnerSettlement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([name])
  @@index([ownerStatus])
  @@index([deletedAt])
}

model RoomTenant {
  id        String     @id @default(uuid())
  roomId    String
  tenantId  String
  room      Room       @relation(fields: [roomId], references: [id])
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  startDate DateTime?
  endDate   DateTime?
  status    LinkStatus @default(ACTIVE)
  createdAt DateTime   @default(now())

  @@index([roomId, status])
  @@index([tenantId])
}

model RoomOwner {
  id             String     @id @default(uuid())
  roomId         String
  ownerId        String
  room           Room       @relation(fields: [roomId], references: [id])
  owner          Owner      @relation(fields: [ownerId], references: [id])
  startDate      DateTime?
  endDate        DateTime?
  ownershipRatio Decimal?   @db.Decimal(8, 4)
  ownershipRole  String     @default("OWNER")
  isPrimary      Boolean    @default(false)
  remark         String?    @db.Text
  status         LinkStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  @@index([roomId, status])
  @@index([ownerId])
  @@index([startDate, endDate])
  @@index([deletedAt])
  @@index([deletedAt, startDate, createdAt])
}

model PropertyOwnership {
  id             String    @id @default(cuid())
  propertyId     String
  ownerId        String
  ownershipRole  String    @default("OWNER")
  ownershipRatio Decimal?  @db.Decimal(7, 4)
  validFrom      DateTime?
  validTo        DateTime?
  isPrimary      Boolean   @default(false)
  remark         String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  property Property @relation(fields: [propertyId], references: [id])
  owner    Owner    @relation(fields: [ownerId], references: [id])

  @@index([propertyId])
  @@index([ownerId])
  @@index([validFrom, validTo])
  @@index([deletedAt])
}

model PropertyImportBatch {
  id           String    @id @default(cuid())
  batchNo      String    @unique
  originalName String
  fileHash     String    @unique
  totalRows    Int       @default(0)
  successRows  Int       @default(0)
  skippedRows  Int       @default(0)
  failedRows   Int       @default(0)
  conflictRows Int       @default(0)
  status       String    @default("PENDING")
  importType   String    @default("PROPERTY")
  mappingJson  Json?
  createdBy    String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  rows PropertyImportRow[]

  @@index([status, createdAt])
}

model PropertyImportRow {
  id                     String   @id @default(cuid())
  batchId                String
  sourceRow              Int
  sourceDataJson         Json
  propertyName           String
  normalizedPropertyName String
  roomNumber             String?
  normalizedRoomNumber   String?
  postalCode             String?
  address                String?
  normalizedAddress      String?
  detectedUnitType       String   @default("ROOM")
  propertyId             String?
  roomId                 String?
  contractId             String?
  contractAction         String?
  contractStatus         String?
  contractDataJson       Json?
  contractConflictReason String?
  action                 String?
  status                 String   @default("PENDING")
  conflictReason         String?
  errorMessage           String?
  remark                 String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  batch    PropertyImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  property Property?           @relation(fields: [propertyId], references: [id])
  room     Room?               @relation(fields: [roomId], references: [id])
  contract Contract?           @relation(fields: [contractId], references: [id])

  @@unique([batchId, sourceRow])
  @@index([propertyId])
  @@index([roomId])
  @@index([contractId])
  @@index([status])
  @@index([action])
}

model Contract {
  id                    String                 @id @default(uuid())
  propertyId            String
  roomId                String
  tenantId              String?
  property              Property               @relation(fields: [propertyId], references: [id])
  room                  Room                   @relation(fields: [roomId], references: [id])
  tenant                Tenant?                @relation(fields: [tenantId], references: [id])
  contractNumber        String?                @unique
  externalContractId    String?                @unique
  contractorName        String?
  contractorNameKana    String?
  contractorType        String?
  payerName             String?
  payerNameKana         String?
  bankSummaryName       String?
  startDate             DateTime?
  endDate               DateTime?
  paymentMethod         String?
  paymentMonthType      String?
  monthlyRent           Decimal?               @db.Decimal(18, 2)
  managementFee         Decimal?               @db.Decimal(18, 2)
  deposit               Decimal?               @db.Decimal(18, 2)
  keyMoney              Decimal?               @db.Decimal(18, 2)
  guaranteeDeposit      Decimal?               @db.Decimal(18, 2)
  guaranteeFee          Decimal?               @db.Decimal(18, 2)
  keyReplacementFee     Decimal?               @db.Decimal(18, 2)
  renewalAdministrativeFee Decimal?            @db.Decimal(18, 2)
  guaranteeCompanyName  String?
  guaranteeCompanyNameKana String?
  insuranceName         String?
  insuranceFee          Decimal?               @db.Decimal(18, 2)
  insurancePeriod       String?
  insuranceStartDate    DateTime?
  insuranceEndDate      DateTime?
  collectionAccount     String?
  managementContractType String?
  remark                String?                @db.Text
  sourceDataJson        Json?
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?
  otherMonthlyFee1Name  String?
  otherMonthlyFee1      Decimal?               @db.Decimal(18, 2)
  otherMonthlyFee2Name  String?
  otherMonthlyFee2      Decimal?               @db.Decimal(18, 2)
  otherMonthlyFee3Name  String?
  otherMonthlyFee3      Decimal?               @db.Decimal(18, 2)
  paymentCycleMonths    Int                    @default(1)
  paymentDay            Int?
  nextDueDate           DateTime?
  reminderDays          Int?
  feeBearer             FeeBearer              @default(OWNER)
  status                ContractStatus         @default(ACTIVE)
  anomalyAlerts         AnomalyAlert[]
  paymentAliases        ContractPaymentAlias[]
  partyHistories        ContractPartyHistory[]
  charges               ContractCharge[]
  importRows            PropertyImportRow[]
  reconciliationRecords ReconciliationRecord[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([propertyId])
  @@index([roomId, status])
  @@index([tenantId])
  @@index([nextDueDate])
  @@index([bankSummaryName])
  @@index([startDate, endDate])
  @@index([deletedAt])
}

model ContractCharge {
  id          String   @id @default(cuid())
  contractId  String
  chargeType  String
  itemName    String
  amount      Decimal? @db.Decimal(18, 2)
  monthCount  Decimal? @db.Decimal(8, 2)
  billingMode String?
  sortOrder   Int      @default(0)
  remark      String?  @db.Text
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contractId])
  @@index([chargeType])
}

model ContractPaymentAlias {
  id                    String    @id @default(cuid())
  contractId            String
  contract              Contract  @relation(fields: [contractId], references: [id])
  payerName             String?
  originalBankSummary   String?
  normalizedBankSummary String
  validFrom             DateTime?
  validTo               DateTime?
  isActive              Boolean   @default(true)
  confirmedCount        Int       @default(0)
  lastConfirmedAt       DateTime?
  remark                String?
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([contractId])
  @@index([normalizedBankSummary])
}

model ContractPartyHistory {
  id           String            @id @default(cuid())
  contractId   String
  contract     Contract          @relation(fields: [contractId], references: [id])
  partyType    ContractPartyType
  partyId      String?
  partyName    String
  validFrom    DateTime?
  validTo      DateTime?
  changeReason String?
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([contractId, partyType])
  @@index([partyId])
}

model FeeItem {
  id        String              @id @default(uuid())
  name      String
  category  FeeCategory
  valueType FeeValueType
  sortOrder Int                 @default(0)
  enabled   Boolean             @default(true)
  details   TransactionDetail[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model Transaction {
  id                 String                @id @default(uuid())
  type               TransactionType
  roomId             String?
  room               Room?                 @relation(fields: [roomId], references: [id])
  date               DateTime
  sequenceNo         Int?
  fileType           String?
  counterparty       String?
  counterpartyRaw    String?
  contentSummary     String?
  fileAmount         Decimal?              @db.Decimal(18, 2)
  transferFeeAmount  Decimal               @default(0) @db.Decimal(18, 2)
  statisticalAmount  Decimal?              @db.Decimal(18, 2)
  evidenceDateType   String?
  sourcePageStart    Int?
  sourcePageEnd      Int?
  processingStatus   FundProcessingStatus  @default(INCLUDED)
  confirmationStatus ConfirmationStatus    @default(PENDING)
  totalAmount        Decimal               @default(0) @db.Decimal(18, 2)
  note               String?
  details            TransactionDetail[]
  bankMatches        ReconciliationMatch[]
  anomalies          Anomaly[]
  anomalyAlerts      AnomalyAlert[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([roomId, date])
  @@index([type, date])
  @@index([processingStatus, confirmationStatus])
}

model TransactionDetail {
  id            String      @id @default(uuid())
  transactionId String
  feeItemId     String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  feeItem       FeeItem     @relation(fields: [feeItemId], references: [id])
  valueMoney    Decimal?    @db.Decimal(18, 2)
  valueNumber   Decimal?    @db.Decimal(18, 4)
  valueText     String?
  valueDate     DateTime?

  @@index([transactionId])
}

model BankTransaction {
  id                    String                   @id @default(uuid())
  accountName           String?
  accountNumber         String?
  bookedAt              DateTime
  direction             BankTransactionDirection
  amount                Decimal                  @db.Decimal(18, 2)
  description           String?
  rawPayload            Json?
  reconciliationStatus  ReconciliationStatus     @default(UNMATCHED)
  matches               ReconciliationMatch[]
  reconciliationRecords ReconciliationRecord[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([bookedAt])
  @@index([direction, amount])
  @@index([reconciliationStatus])
}

model ReconciliationBatch {
  id                 String                     @id @default(cuid())
  batchNo            String                     @unique
  status             ReconciliationBatchStatus  @default(PENDING)
  matchingRulesJson  Json?
  templateId         String?
  template           ReconciliationTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateSnapshotJson Json?
  totalRecords       Int                        @default(0)
  autoMatchedCount   Int                        @default(0)
  manualMatchedCount Int                        @default(0)
  unmatchedCount     Int                        @default(0)
  submittedCount     Int                        @default(0)
  failedCount        Int                        @default(0)
  uploadedBy         String?
  remark             String?
  sourceFiles        ReconciliationSourceFile[]
  records            ReconciliationRecord[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([templateId])
}

model ReconciliationTemplate {
  id              String                @id @default(cuid())
  name            String
  description     String?
  createdByUserId String
  createdBy       User                  @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  version         Int                   @default(1)
  configurationJson Json
  isActive        Boolean               @default(true)
  deletedAt       DateTime?
  batches         ReconciliationBatch[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([createdByUserId, name])
  @@index([createdByUserId, isActive])
}

model ReconciliationSourceFile {
  id          String                 @id @default(cuid())
  batchId     String
  batch       ReconciliationBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    String?
  fileSize    Int?
  fileHash    String
  storageKey  String?
  rawMetadata Json?
  uploadedBy  String?
  records     ReconciliationRecord[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([batchId])
  @@index([fileHash])
}

enum BankStatementScanStatus {
  VALIDATING
  READY
  DUPLICATE
  QUEUED
  PREPROCESSING
  OCR_RUNNING
  TABLE_ANALYSIS
  DATA_NORMALIZATION
  VALIDATING_RESULTS
  REVIEW_REQUIRED
  GENERATING_EXCEL
  COMPLETED
  FAILED
  CANCELLED
}

model BankStatementScanTask {
  id                 String                  @id @default(cuid())
  scanNo             String                  @unique
  originalFilename   String
  storageKey         String
  mimeType           String                  @default("application/pdf")
  fileSize           Int
  checksum           String
  pageCount          Int?
  createdByUserId    String?
  status             BankStatementScanStatus @default(VALIDATING)
  progress           Int                     @default(0)
  processedPageCount Int                     @default(0)
  extractedRowCount  Int                     @default(0)
  warningCount       Int                     @default(0)
  currentStage       String?
  providerProfileId  String?
  providerType       String?
  providerModel      String?
  providerSnapshot   Json?
  generatedFileId    String?
  errorCode          String?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([createdByUserId, createdAt])
  @@index([checksum])
  @@index([status, createdAt])
}

model ReconciliationRecord {
  id                        String                          @id @default(cuid())
  batchId                   String
  batch                     ReconciliationBatch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceFileId              String?
  sourceFile                ReconciliationSourceFile?       @relation(fields: [sourceFileId], references: [id])
  sourcePage                Int?
  sourceRow                 Int?
  sourceDataJson            Json
  transactionDate           DateTime?
  depositAmount             Decimal?                        @db.Decimal(18, 2)
  originalBankSummary       String?
  normalizedBankSummary     String?
  registeredBankSummaryName String?
  propertyId                String?
  property                  Property?                       @relation(fields: [propertyId], references: [id])
  roomId                    String?
  room                      Room?                           @relation(fields: [roomId], references: [id])
  contractId                String?
  contract                  Contract?                       @relation(fields: [contractId], references: [id])
  contractorId              String?
  contractorName            String?
  payerId                   String?
  payerName                 String?
  paymentMonth              String?
  matchMode                 ReconciliationRecordMatchMode   @default(UNMATCHED)
  matchScore                Int?
  matchStatus               ReconciliationRecordMatchStatus @default(UNMATCHED)
  matchReason               String?
  matchingRulesJson         Json?
  targetTable               String?
  targetRecordId            String?
  bankTransactionId         String?
  bankTransaction           BankTransaction?                @relation(fields: [bankTransactionId], references: [id])
  transactionCategory       String?
  feeType                   String?
  remark                    String?
  recordHash                String
  submittedAt               DateTime?
  submittedBy               String?
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt

  @@index([batchId])
  @@index([sourceFileId])
  @@index([matchStatus])
  @@index([normalizedBankSummary])
  @@index([transactionDate])
  @@index([recordHash])
  @@index([targetTable, targetRecordId])
  @@index([propertyId, roomId])
  @@index([contractId])
}

model BankNameAlias {
  id             String    @id @default(uuid())
  rawName        String
  normalizedName String
  tenantId       String?
  ownerId        String?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id])
  owner          Owner?    @relation(fields: [ownerId], references: [id])
  confidence     Decimal?  @db.Decimal(5, 4)
  confirmedBy    String?
  confirmedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([normalizedName])
  @@index([tenantId])
  @@index([ownerId])
}

model ReconciliationMatch {
  id                String          @id @default(uuid())
  transactionId     String
  bankTransactionId String
  transaction       Transaction     @relation(fields: [transactionId], references: [id])
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id])
  confidence        Decimal         @db.Decimal(5, 4)
  reason            String?
  confirmedBy       String?
  confirmedAt       DateTime?
  createdAt         DateTime        @default(now())

  @@unique([transactionId, bankTransactionId])
}

model OwnerSettlement {
  id                  String           @id @default(uuid())
  ownerId             String
  owner               Owner            @relation(fields: [ownerId], references: [id])
  periodStart         DateTime
  periodEnd           DateTime
  grossIncomeAmount   Decimal          @default(0) @db.Decimal(18, 2)
  managementFeeAmount Decimal          @default(0) @db.Decimal(18, 2)
  expenseAmount       Decimal          @default(0) @db.Decimal(18, 2)
  transferFeeAmount   Decimal          @default(0) @db.Decimal(18, 2)
  overdueAmount       Decimal          @default(0) @db.Decimal(18, 2)
  remittanceAmount    Decimal          @default(0) @db.Decimal(18, 2)
  status              SettlementStatus @default(DRAFT)
  reviewedBy          String?
  reviewedAt          DateTime?
  note                String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([ownerId, periodStart, periodEnd])
  @@index([status])
}

model Anomaly {
  id            String          @id @default(uuid())
  transactionId String?
  transaction   Transaction?    @relation(fields: [transactionId], references: [id])
  severity      AnomalySeverity
  code          String
  message       String
  metadata      Json?
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())

  @@index([severity, createdAt])
}

model AnomalyAlert {
  id               String          @id @default(uuid())
  propertyId       String?
  roomId           String?
  contractId       String?
  transactionId    String?
  property         Property?       @relation(fields: [propertyId], references: [id])
  room             Room?           @relation(fields: [roomId], references: [id])
  contract         Contract?       @relation(fields: [contractId], references: [id])
  transaction      Transaction?    @relation(fields: [transactionId], references: [id])
  alertType        String
  severity         AnomalySeverity
  amount           Decimal?        @db.Decimal(18, 2)
  differenceAmount Decimal?        @db.Decimal(18, 2)
  occurredOn       DateTime?
  status           AlertStatus     @default(OPEN)
  assigneeUserId   String?
  handledBy        String?
  handledAt        DateTime?
  resolutionNote   String?
  changedFields    Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, severity])
  @@index([propertyId, alertType])
  @@index([roomId, alertType])
}

enum OcrTaskStatus {
  PENDING
  UPLOADING
  PROCESSING
  COMPLETED
  REVIEW_REQUIRED
  FAILED
}

model OcrTask {
  id              String        @id @default(uuid())
  taskId          String        @unique
  taskName        String?
  webhookUrl      String
  callbackUrl     String
  state           OcrTaskStatus @default(PENDING)
  fileNames       String[]
  resultJson      Json?
  callbackPayload Json?
  reviewStatus    String?       @default("PENDING")
  errorMessage    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Document {
  id            String              @id @default(uuid())
  roomId        String?
  tenantId      String?
  ownerId       String?
  propertyId    String?
  room          Room?               @relation(fields: [roomId], references: [id])
  tenant        Tenant?             @relation(fields: [tenantId], references: [id])
  owner         Owner?              @relation(fields: [ownerId], references: [id])
  property      Property?           @relation(fields: [propertyId], references: [id])
  documentType  String
  fileName      String
  storageKey    String?
  ocrText       String?
  extractedJson Json?
  status        String              @default("PENDING_CONFIRM")
  knowledge     KnowledgeDocument[]
  pageCoverage  PageCoverage[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model PageCoverage {
  id                 String         @id @default(uuid())
  documentId         String
  document           Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber         Int
  readStatus         PageReadStatus @default(UNREAD)
  relatedSequenceNos Int[]          @default([])
  fileType           String?
  pageNote           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([documentId, pageNumber])
  @@index([readStatus])
}

model KnowledgeDocument {
  id         String    @id @default(uuid())
  roomId     String?
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  title      String
  content    String?
  sourceType String?
  metadata   Json?
  createdAt  DateTime  @default(now())
}

model AnomalyThresholdConfig {
  id               String         @id @default(uuid())
  scope            ThresholdScope
  propertyId       String?
  contractId       String?
  anomalyType      String
  graceDays        Int?
  amountTolerance  Decimal?       @db.Decimal(18, 2)
  percentTolerance Decimal?       @db.Decimal(8, 4)
  reminderLeadDays Int?
  enabled          Boolean        @default(true)
  updatedBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([scope, anomalyType, enabled])
  @@index([propertyId])
  @@index([contractId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}
